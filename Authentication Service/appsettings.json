{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JwtSettings": {
    "Issuer": "IdentityService",
    "Audience": "MyAPI",
    "TokenExpiryMinutes": 60
  },
  "Vault": {
    "Address": "http://vault:8200",
    "KeyName": "jwt-signing-key",
    "RoleId": "",
    "SecretId": ""
  },
  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },
  "RateLimiting": {
    "MaxRequests": 5,
    "WindowSeconds": 300,
    "IpMaxRequests": 20,
    "IpWindowSeconds": 300,
    "KnownProxies": [
    ],
    "InitialWhitelist": [
      "127.0.0.1",
      "::1"
    ]
  },
  "AllowedHosts": "*"
}