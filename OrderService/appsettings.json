{
  "Serilog": {
    "MinimumLevel": "Information",
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://seq:80"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "RabbitMq": {
    "HostName": "rabbitmq",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest"
  },
  "JwtSettings": {
    "Issuer": "IdentityService",
    "Audience": "MyAPI"
  },
  "Vault": {
    "Address": "http://trading-vault:8200",
    "KeyName": "jwt-signing-key",
    "RoleId": "",
    "SecretId": ""
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=postgres;Port=5432;Database=mydatabase;Username=myuser;Password=mypassword",
    "Redis": "localhost:6379"
  },
  "RateLimiting": {
    "MaxRequests": 100,
    "WindowSeconds": 60
  }
}
